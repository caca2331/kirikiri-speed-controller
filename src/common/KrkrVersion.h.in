#pragma once

// Generated by CMake from project(VERSION ...) in CMakeLists.txt; change the version there only.
#define KRKR_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define KRKR_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define KRKR_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define KRKR_VERSION_STRING "@PROJECT_VERSION@"
#define KRKR_VERSION_WSTRING L"@PROJECT_VERSION@"
// major * 10000 + minor * 100 + patch, e.g. 1.2.1 -> 10201.
#define KRKR_VERSION_PACKED (KRKR_VERSION_MAJOR * 10000u + KRKR_VERSION_MINOR * 100u + KRKR_VERSION_PATCH)
